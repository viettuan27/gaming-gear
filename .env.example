# PostgreSQL
POSTGRES_DB=gaming_gear_db
POSTGRES_USER=admin
POSTGRES_PASSWORD=change-me-in-local-env
POSTGRES_HOST_PORT=5436

# JWT - chuỗi ví dụ này chỉ dùng cho local; hãy thay bằng secret Base64 ngẫu nhiên khi deploy
JWT_SECRET_BASE64=cmVwbGFjZS13aXRoLXlvdXItb3duLWxvbmctbG9jYWwtZGV2ZWxvcG1lbnQtc2VjcmV0LTIwMjY=

# Redis
REDIS_HOST=localhost
REDIS_HOST_PORT=6380

# MinIO
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=change-me-in-local-env
MINIO_ENDPOINT=http://localhost:9000
MINIO_PUBLIC_URL=http://localhost:9000
MINIO_BUCKET=gaming-gear
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

# Local host ports
APP_HOST_PORT=8080
STOREFRONT_HOST_PORT=5173
ADMIN_HOST_PORT=5174

# Rate limit (fixed window, Redis)
RATE_LIMIT_LOGIN_IP_LIMIT=20
RATE_LIMIT_LOGIN_ACCOUNT_LIMIT=8
RATE_LIMIT_LOGIN_WINDOW=1m
RATE_LIMIT_REGISTER_IP_LIMIT=5
RATE_LIMIT_REGISTER_ACCOUNT_LIMIT=3
RATE_LIMIT_REGISTER_WINDOW=1h
RATE_LIMIT_REFRESH_IP_LIMIT=30
RATE_LIMIT_REFRESH_WINDOW=1m
RATE_LIMIT_UPLOAD_USER_LIMIT=30
RATE_LIMIT_UPLOAD_IP_LIMIT=60
RATE_LIMIT_UPLOAD_WINDOW=1m
